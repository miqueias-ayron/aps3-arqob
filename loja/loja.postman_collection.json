{
  "info": {
    "name": "Loja API",
    "description": "Collection para testar as rotas da API da loja virtual. Rode as pastas em ordem (Collection Runner): os testes salvam os IDs criados nas variáveis da collection.\n\nAuth: HTTP Basic com {{email}} / {{senha}}. Crie o usuário primeiro em '0 - Usuário'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{email}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{senha}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "email",
      "value": "admin@teste.com"
    },
    {
      "key": "senha",
      "value": "123456"
    },
    {
      "key": "lojaId",
      "value": "1"
    },
    {
      "key": "categoriaId",
      "value": "1"
    },
    {
      "key": "outraCategoriaId",
      "value": "2"
    },
    {
      "key": "produtoCodigo",
      "value": "1"
    },
    {
      "key": "produtoRemoverCodigo",
      "value": "2"
    },
    {
      "key": "clienteId",
      "value": "1"
    },
    {
      "key": "clienteCpf",
      "value": "12345678900"
    },
    {
      "key": "pedidoNumero",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "0 - Usuário",
      "item": [
        {
          "name": "Criar usuário",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"senha\": \"{{senha}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
