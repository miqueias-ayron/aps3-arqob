          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/campeonatos/{{campeonatoId}}/times/{{timeVisitanteId}}", "host": ["{{baseUrl}}"], "path": ["campeonatos", "{{campeonatoId}}", "times", "{{timeVisitanteId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
