          ]
        },
        {
          "name": "Listar times do campeonato",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/campeonatos/{{campeonatoId}}/times", "host": ["{{baseUrl}}"], "path": ["campeonatos", "{{campeonatoId}}", "times"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
