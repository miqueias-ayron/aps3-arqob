        },
        {
          "name": "Buscar time no campeonato por nome",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/campeonatos/{{campeonatoId}}/times/busca?nome=Flamengo",
              "host": ["{{baseUrl}}"],
              "path": ["campeonatos", "{{campeonatoId}}", "times", "busca"],
              "query": [{ "key": "nome", "value": "Flamengo" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4 - Partidas",
      "item": [
        {
          "name": "Criar partida",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": \"2026-10-20\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/partidas?campeonatoId={{campeonatoId}}&mandanteId={{timeMandanteId}}&visitanteId={{timeVisitanteId}}",
              "host": ["{{baseUrl}}"],
              "path": ["partidas"],
              "query": [
                { "key": "campeonatoId", "value": "{{campeonatoId}}" },
                { "key": "mandanteId", "value": "{{timeMandanteId}}" },
                { "key": "visitanteId", "value": "{{timeVisitanteId}}" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('partidaId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar partida por id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/partidas/{{partidaId}}", "host": ["{{baseUrl}}"], "path": ["partidas", "{{partidaId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar gols",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/partidas/{{partidaId}}/gols?golMandante=2&golVisitante=1",
              "host": ["{{baseUrl}}"],
              "path": ["partidas", "{{partidaId}}", "gols"],
              "query": [
                { "key": "golMandante", "value": "2" },
                { "key": "golVisitante", "value": "1" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar cartão",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"minuto\": 35,\n  \"tipo\": \"AMARELO\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/partidas/{{partidaId}}/cartoes?jogadorId={{jogadorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["partidas", "{{partidaId}}", "cartoes"],
              "query": [{ "key": "jogadorId", "value": "{{jogadorId}}" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Placar da partida",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/partidas/{{partidaId}}/placar", "host": ["{{baseUrl}}"], "path": ["partidas", "{{partidaId}}", "placar"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
