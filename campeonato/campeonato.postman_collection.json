        },
        {
          "name": "Adicionar time mandante ao campeonato",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/campeonatos/{{campeonatoId}}/times/{{timeMandanteId}}", "host": ["{{baseUrl}}"], "path": ["campeonatos", "{{campeonatoId}}", "times", "{{timeMandanteId}}"] }
          },
          "event": [
            {
