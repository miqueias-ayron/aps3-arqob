            }
          ]
        },
        {
          "name": "Vencedor da partida",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/partidas/{{partidaId}}/vencedor", "host": ["{{baseUrl}}"], "path": ["partidas", "{{partidaId}}", "vencedor"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 ou 204', () => pm.expect(pm.response.code).to.be.oneOf([200, 204]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar partidas do campeonato",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/campeonatos/{{campeonatoId}}/partidas", "host": ["{{baseUrl}}"], "path": ["campeonatos", "{{campeonatoId}}", "partidas"] }
          },
          "event": [
